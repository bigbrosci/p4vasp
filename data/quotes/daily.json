[
  {"text":"学而不思则罔，思而不学则殆。","source":"论语·为政","url":"https://ctext.org/analects/wei-zheng/ens"},
  {"text":"温故而知新，可以为师矣。","source":"论语·为政","url":"https://ctext.org/analects/wei-zheng/ens"},
  {"text":"知之为知之，不知为不知，是知也。","source":"论语·为政","url":"https://ctext.org/analects/wei-zheng/ens"},
  {"text":"君子周而不比，小人比而不周。","source":"论语·为政","url":"https://ctext.org/analects/wei-zheng/ens"},
  {"text":"人而无信，不知其可也。","source":"论语·为政","url":"https://ctext.org/analects/wei-zheng/ens"},
  {"text":"君子不器。","source":"论语·为政","url":"https://ctext.org/analects/wei-zheng/ens"},
  {"text":"学不可以已。","source":"荀子·劝学","url":"https://ctext.org/xunzi/quan-xue"},
  {"text":"青，取之于蓝，而青于蓝；冰，水为之，而寒于水。","source":"荀子·劝学","url":"https://ctext.org/xunzi/quan-xue"},
  {"text":"木受绳则直，金就砺则利。","source":"荀子·劝学","url":"https://ctext.org/xunzi/quan-xue"},
  {"text":"不积跬步，无以至千里；不积小流，无以成江海。","source":"荀子·劝学","url":"https://ctext.org/xunzi/quan-xue"},
  {"text":"锲而不舍，金石可镂。","source":"荀子·劝学","url":"https://ctext.org/xunzi/quan-xue"},
  {"text":"千里之行，始于足下。","source":"老子·第六十四章","url":"https://ctext.org/text.pl?if=en&node=11655&remap=gb&show=parallel"}
