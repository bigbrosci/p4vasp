[
  {
    "text": "学而不思则罔，思而不学则殆。",
    "source": "论语·为政",
    "url": "https://ctext.org/analects/wei-zheng/ens",
    "language": "zh"
  },
  {
    "text": "温故而知新，可以为师矣。",
    "source": "论语·为政",
    "url": "https://ctext.org/analects/wei-zheng/ens",
    "language": "zh"
  },
  {
    "text": "知之为知之，不知为不知，是知也。",
    "source": "论语·为政",
    "url": "https://ctext.org/analects/wei-zheng/ens",
    "language": "zh"
  },
  {
    "text": "Trust thyself: every heart vibrates to that iron string.",
    "source": "Ralph Waldo Emerson, Self-Reliance",
    "url": "https://www.gutenberg.org/cache/epub/2944/pg2944-images.html",
    "language": "en"
  },
  {
    "text": "君子周而不比，小人比而不周。",
    "source": "论语·为政",
    "url": "https://ctext.org/analects/wei-zheng/ens",
    "language": "zh"
  },
  {
    "text": "人而无信，不知其可也。",
    "source": "论语·为政",
    "url": "https://ctext.org/analects/wei-zheng/ens",
    "language": "zh"
  },
  {
    "text": "君子不器。",
    "source": "论语·为政",
    "url": "https://ctext.org/analects/wei-zheng/ens",
    "language": "zh"
  },
  {
    "text": "Nothing is at last sacred but the integrity of your own mind.",
    "source": "Ralph Waldo Emerson, Self-Reliance",
    "url": "https://www.gutenberg.org/cache/epub/2944/pg2944-images.html",
    "language": "en"
  },
  {
    "text": "学不可以已。",
    "source": "荀子·劝学",
    "url": "https://ctext.org/xunzi/quan-xue",
    "language": "zh"
  },
  {
    "text": "青，取之于蓝，而青于蓝；冰，水为之，而寒于水。",
    "source": "荀子·劝学",
    "url": "https://ctext.org/xunzi/quan-xue",
    "language": "zh"
  },
  {
    "text": "木受绳则直，金就砺则利。",
    "source": "荀子·劝学",
    "url": "https://ctext.org/xunzi/quan-xue",
    "language": "zh"
  },
  {
    "text": "Nothing can bring you peace but yourself.",
    "source": "Ralph Waldo Emerson, Self-Reliance",
    "url": "https://www.gutenberg.org/cache/epub/2944/pg2944-images.html",
    "language": "en"
  },
  {
    "text": "不积跬步，无以至千里；不积小流，无以成江海。",
    "source": "荀子·劝学",
    "url": "https://ctext.org/xunzi/quan-xue",
    "language": "zh"
  },
  {
    "text": "锲而不舍，金石可镂。",
    "source": "荀子·劝学",
    "url": "https://ctext.org/xunzi/quan-xue",
    "language": "zh"
  },
  {
    "text": "千里之行，始于足下。",
    "source": "老子·第六十四章",
    "url": "https://ctext.org/text.pl?if=en&node=11655&remap=gb&show=parallel",
    "language": "zh"
  },
  {
    "text": "This above all: to thine own self be true,",
    "source": "William Shakespeare, Hamlet, Act 1, Scene 3",
    "url": "https://shakespeare.folger.edu/downloads/pdf/hamlet_PDF_FolgerShakespeare.pdf",
    "language": "en"
  }
]
